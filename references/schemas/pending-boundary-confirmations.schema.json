{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pending_boundary_confirmations",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "input_sha256",
    "rule_release_version",
    "requirement_name",
    "status",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_release_version": {"type": "string", "minLength": 1},
    "requirement_name": {"type": "string", "minLength": 1},
    "status": {"enum": ["clear", "awaiting_user_confirmation"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "boundary_id",
          "module",
          "question",
          "recommendation",
          "source_refs"
        ],
        "properties": {
          "boundary_id": {"type": "string", "pattern": "^BOUNDARY-[0-9]{4}$"},
          "module": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
