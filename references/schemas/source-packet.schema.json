{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_packet",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "package_sha256",
    "files",
    "counts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "path",
          "file_name",
          "extension",
          "size_bytes",
          "sha256",
          "status",
          "content_units",
          "evidence",
          "excluded_items",
          "external_links",
          "warnings"
        ]
      }
    },
    "counts": {"type": "object"}
  }
}
