{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_evidence_ledger",
  "type": "object",
  "required": ["schema_version", "package_sha256", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_id",
          "source_ref",
          "kind",
          "path",
          "sha256",
          "visual_review_required",
          "review_status",
          "observations"
        ]
      }
    }
  }
}
