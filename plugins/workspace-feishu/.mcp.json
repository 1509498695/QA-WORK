{
  "mcpServers": {
    "workspace_feishu": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--no-progress",
        "--color",
        "never",
        "--no-python-downloads",
        "--managed-python",
        "--python",
        "3.13",
        "--project",
        "./runtime",
        "--locked",
        "--no-env-file",
        "feishu-provider"
      ],
      "cwd": ".",
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 1800,
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
        "PYTHONHOME": "",
        "PYTHONPATH": "",
        "VIRTUAL_ENV": "",
        "CONDA_PREFIX": "",
        "UV_PYTHON": "",
        "UV_PYTHON_INSTALL_DIR": "",
        "UV_PROJECT_ENVIRONMENT": ""
      }
    }
  }
}
