{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "completeness_matrix",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "input_sha256",
    "rule_release_version",
    "dimensions"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["dimension_id", "status", "reason", "evidence_refs"],
        "properties": {
          "dimension_id": {"pattern": "^GR-0[1-8]$"},
          "status": {"enum": ["covered", "not_applicable", "pending"]}
        }
      }
    }
  }
}
